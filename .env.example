# Copy to .env.local for local work; add the same values in Vercel → Project → Settings → Environment Variables.

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx            # server only, never expose

# ── Meta app (App Dashboard → App settings → Basic) ──
META_APP_SECRET=xxx                           # used to check webhook signatures
META_WEBHOOK_VERIFY_TOKEN=pick-any-long-random-string   # type the same into Meta's webhook setup

# ── Meta's free test number (App Dashboard → WhatsApp → API Setup) ──
META_SANDBOX_ACCESS_TOKEN=xxx                 # temporary token (24 h) or a system-user token
META_SANDBOX_PHONE_NUMBER_ID=xxx
META_SANDBOX_WABA_ID=xxx                      # "WhatsApp Business Account ID"

# Pinned Graph API version; change deliberately after reading Meta's changelog
GRAPH_API_VERSION=v26.0

# ── Shown on /privacy and /terms (fill once the legal entity is settled) ──
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
